<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="10.0"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="view.ProgramExecutorController">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Number of PrgStates:" />
                <TextField fx:id="numberOfPrgStatesTextField" editable="false" prefWidth="50.0" />
                <Button fx:id="runOneStepButton" mnemonicParsing="false" text="Run One Step" />
                <Button fx:id="runAllButton" mnemonicParsing="false" text="Run All Steps" />
            </children>
        </HBox>

        <HBox spacing="10.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Heap Table" />
                        <TableView fx:id="heapTableView" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="addressColumn" text="Address" />
                                <TableColumn fx:id="valueColumn" text="Value" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Output List" />
                        <ListView fx:id="outputListView" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>

                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="File Table" />
                        <ListView fx:id="fileTableListView" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox spacing="10.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="PrgState Identifiers" />
                        <ListView fx:id="prgStateIdentifiersListView" onMouseClicked="#changeProgramState" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>

                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Symbol Table" />
                        <TableView fx:id="symbolTableView" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="symVarNameColumn" text="Variable Name" />
                                <TableColumn fx:id="symValueColumn" text="Value" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Execution Stack" />
                        <ListView fx:id="executionStackListView" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>